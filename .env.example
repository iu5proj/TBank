# === Database ===
POSTGRES_USER=zarabotok
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=zarabotok_db
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://zarabotok:change_me_in_production@postgres:5432/zarabotok_db

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === GPT-OSS model service ===
GPT_OSS_SERVICE_URL=http://ml_service:8001
GPT_OSS_ANALYZE_PATH=/analyze
GPT_OSS_CLIENT_MODE=service
GPT_OSS_BASE_URL=http://llm-service:8000/v1
GPT_OSS_API_KEY=local-dev-key
GPT_OSS_MODEL_NAME=gpt-oss-20b
GPT_OSS_MODEL_VERSION=gpt-oss-20b-salary-v1
GPT_OSS_PROMPT_VERSION=salary_estimation_prompt_v13
GPT_OSS_TIMEOUT=90
GPT_OSS_MAX_TOKENS=1400
GPT_OSS_TEMPERATURE=0.1

# === Vacancy parser / RAG ===
# HH may be blocked. Disable it with VACANCY_SOURCES=trudvsem,habr,fixture
VACANCY_SOURCES=hh,trudvsem,habr,fixture
VACANCY_SOURCE_TIMEOUT=20
VACANCY_SOURCE_LIMIT=80
MIN_CANDIDATE_VACANCIES=5
MIN_REFRESHED_VACANCIES=1
SEGMENT_STALE_DAYS=14
MAX_STALE_SEGMENT_DAYS=45
PARSER_ENABLE_FIXTURE_SOURCE=true
HH_BASE_URL=https://api.hh.ru
TRUDVSEM_BASE_URL=https://opendata.trudvsem.ru/api/v1
HABR_CAREER_BASE_URL=https://career.habr.com
HABR_CAREER_API_TOKEN=
PARSER_USER_AGENT=ZarabotokMLRAG/0.1
LLM_LOCK_TTL_SECONDS=120

# === Legacy ML Service ===
ML_SERVICE_URL=http://ml_service:8001
ML_SERVICE_HOST_PORT=8002

# === ML Service runtime ===
# stub keeps local smoke tests fast. openai_compatible proxies /analyze to a
# model runner: Ollama native /api/generate when ML_OPENAI_API_STYLE=ollama, else
# OpenAI-compatible /chat/completions.
ML_PREDICTOR_MODE=stub
# Use http://ollama:11434/v1 for compose Ollama.
# Use http://host.docker.internal:11434/v1 for host/WSL Ollama.
ML_OPENAI_BASE_URL=http://ollama:11434/v1
ML_OPENAI_API_KEY=local-dev-key
ML_OPENAI_MODEL_NAME=gpt-oss:20b
ML_OPENAI_API_STYLE=ollama
ML_OPENAI_TIMEOUT=25
ML_OPENAI_MAX_TOKENS=500
ML_OPENAI_NUM_CTX=4096
ML_OPENAI_TEMPERATURE=0.1
ML_OPENAI_REASONING_EFFORT=none
ML_OPENAI_JSON_MODE=true
ML_OPENAI_PROMPT_PATH=
OLLAMA_HOST_PORT=11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_LOAD_TIMEOUT=10m

# === Anthropic Claude API ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# === Backend ===
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
SECRET_KEY=change_me_to_random_string
DEBUG=true
API_AUTH_TOKEN=
RATE_LIMIT_ANALYZE_PER_MINUTE=30

# === Frontend ===
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_ANALYZE_TIMEOUT_MS=120000
# Optional browser-visible token for private demos only. For public production,
# prefer external auth/reverse proxy controls instead of exposing a shared token.
NEXT_PUBLIC_API_AUTH_TOKEN=
