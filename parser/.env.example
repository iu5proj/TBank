# === Database (optional — can use --csv-output instead) ===
DATABASE_URL=postgresql+asyncpg://zarabotok:change_me_in_production@localhost:5432/zarabotok_db

# === Parser Settings ===
# Comma-separated search queries (leave empty to use built-in 90+ queries)
# PARSER_SEARCH_TEXTS=python developer,java developer
PARSER_MAX_PAGES=20
PARSER_MAX_CONCURRENCY=5
PARSER_SAVE_BATCH_SIZE=200

# === HH.ru ===
# Area IDs: 113=Russia, 1=Moscow, 2=SPb (leave empty to use built-in 15 regions)
# HH_AREAS=113,1,2
HH_RATE_LIMIT_RPS=2.0
# Set to true for fast collection without fetching individual vacancy pages
HH_SKIP_DETAILS=false

# === Habr Career ===
HABR_RATE_LIMIT_RPS=0.5

# === SuperJob (requires API key from https://api.superjob.ru/) ===
SUPERJOB_APP_ID=
SUPERJOB_RATE_LIMIT_RPS=1.0

# === Currency Rates (manual override, optional) ===
PARSER_USD_RUB=90.0
PARSER_EUR_RUB=98.0
